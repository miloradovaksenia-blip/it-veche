# Скопируйте в .env (или задайте в панели хостинга). Секреты — только на сервере.
NODE_ENV=production
PORT=3000

# Пароль организатора (не короче 10 символов). Никогда не попадает в клиентский код.
ADMIN_PASSWORD=change-me-strong-password

# Секрет для подписи cookie и HMAC ключей участников (не короче 32 символов).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Публичный HTTPS-адрес портала для QR-кода. Необязательно: по умолчанию берётся адрес, по которому открыт сайт.
PUBLIC_BASE_URL=https://veche.example.com

# База данных — один из двух вариантов:
# 1) PostgreSQL (например, бесплатный Neon). Если задан, используется вместо SQLite.
#    Строку подключения берите из панели Neon (без параметра channel_binding).
DATABASE_URL=
# 2) SQLite-файл. На хостинге — только на постоянном диске (volume).
DB_PATH=/data/veche.db

# Сколько прокси перед приложением (для корректного IP в rate limit). Обычно 1.
TRUST_PROXY=1

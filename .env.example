# Скопируйте в .env (или задайте в панели хостинга). Секреты — только на сервере.
NODE_ENV=production
PORT=3000

# Пароль организатора (не короче 10 символов). Никогда не попадает в клиентский код.
ADMIN_PASSWORD=change-me-strong-password

# Секрет для подписи cookie и HMAC ключей участников (не короче 32 символов).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Публичный HTTPS-адрес портала — на него ведут QR-код и короткая ссылка.
PUBLIC_BASE_URL=https://veche.example.com

# Путь к файлу БД SQLite. На хостинге — на постоянном диске (volume).
DB_PATH=/data/veche.db

# Сколько прокси перед приложением (для корректного IP в rate limit). Обычно 1.
TRUST_PROXY=1
